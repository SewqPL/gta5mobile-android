<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Makes the game activity a floating window.

      A NativeActivity's window is normally the entire display: Android gives the
      activity the whole screen and the native surface is that surface, so
      winit's inner_size() always reported the full panel and neither
      with_inner_size() nor set_fullscreen() had anywhere to act. windowIsFloating
      switches the activity to a window type whose explicit width and height are
      honoured, which is what lets the game occupy part of the screen instead of
      all of it. GameActivity sets the exact pixel size in onCreate, because dp
      scales with device density and would give a different pixel size per device.

      TouchControls needs no change: it lives in a TYPE_APPLICATION_PANEL window
      sized MATCH_PARENT, which resolves against this window rather than the
      display, so the HUD follows the game.
    -->
    <style name="MuguetGameWindow" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowGravity">center</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/black</item>
    </style>
</resources>